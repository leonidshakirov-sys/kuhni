# Публичный адрес сайта без завершающего слэша.
# Нужен для canonical, Open Graph, sitemap и JSON-LD.
# На VPS Beget указать https://www.vrazmerdom.ru
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Порт Node.js за Nginx. Снаружи не открывать.
PORT=3000

# Яндекс.Метрика. На сайте уже стоит счётчик 111656931.
# Укажите другой ID, только если нужно заменить счётчик.
NEXT_PUBLIC_YANDEX_METRIKA_ID=111656931

# Telegram: заявки с форм. Если пусто, сайт работает,
# формы показывают успех, но сообщение в Telegram не уходит.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
